# ============================================================================
#  Astroventure Nights — environment variables
#  Copy this file to ".env.local" (local) or add these in Vercel → Settings →
#  Environment Variables (production).
#
#  The Astroventure enquiry forms below work with none of these set.
#  The NAKSHATRAALAY BOOKING SYSTEM does not: without Cashfree it cannot take
#  payment, without Google Sheets it cannot count seats, and without Resend it
#  cannot email a guest. Those sections are marked REQUIRED further down.
# ============================================================================

# --- Email delivery ---------------------------------------------------------
# Booking enquiries work OUT OF THE BOX via FormSubmit (no key needed) and are
# delivered to the two addresses below.
#
# ⚠️ ONE-TIME STEP: the first time the form is submitted, FormSubmit emails an
# activation link to NOTIFY_EMAIL_1 (astriseducation@gmail.com). Open that
# email and click the link once — after that every enquiry arrives automatically
# (with NOTIFY_EMAIL_2 CC'd).
NOTIFY_EMAIL_1=astriseducation@gmail.com
NOTIFY_EMAIL_2=eeshumtravels@gmail.com

# --- Optional upgrades (set either to override FormSubmit) -------------------
# Web3Forms — free, no domain to verify. Key from https://web3forms.com
WEB3FORMS_ACCESS_KEY=

# Resend — needs a verified sending domain. https://resend.com
RESEND_API_KEY=
# Leave blank to use Resend's shared onboarding@resend.dev sender.
NOTIFY_FROM=

# The canonical URL lives in lib/site-config.ts (SITE_URL), not here.

# --- Razorpay (Nakshatraalay reservations) ----------------------------------
# From Razorpay Dashboard → Account & Settings → API Keys.
# KEY_ID is publishable and reaches the browser; the other two never do.
# Dashboard → Settings → Webhooks. Point it at:
#   https://www.astriseducation.in/api/reservations/webhook
# subscribed to `payment.captured`, and paste the secret you set there.

# --- Where paid bookings are emailed ----------------------------------------
NOTIFY_EMAIL_1=astriseducation@gmail.com
NOTIFY_EMAIL_2=
# Server-side email. Web3Forms works without a domain; Resend needs one.
WEB3FORMS_ACCESS_KEY=

# =============================================================================
#  PAYMENTS — CASHFREE  [REQUIRED for Nakshatraalay bookings]
#  Dashboard -> Developers -> API Keys. The secret is shown once.
# =============================================================================
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Exactly "sandbox" or "production". There is NO default: unset means payments
# are switched off, which is safer than guessing wrong in either direction.
CASHFREE_ENV=sandbox
# Optional. Defaults to CASHFREE_SECRET_KEY, which is what Cashfree signs with
# unless you set a separate secret on the webhook itself.
CASHFREE_WEBHOOK_SECRET=
# Webhook URL to register in the Cashfree dashboard:
#   https://www.astriseducation.in/api/reservations/webhook
#   event: PAYMENT_SUCCESS_WEBHOOK

# =============================================================================
#  BOOKING LEDGER — GOOGLE SHEETS  [REQUIRED for seat availability]
#  This is what seat availability is counted from.
#  The sheet MUST be shared with GOOGLE_SERVICE_ACCOUNT_EMAIL as an Editor —
#  that is the step that is always missed.
# =============================================================================
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The whole PEM. In Vercel paste it with real newlines; literal \n also works.
GOOGLE_PRIVATE_KEY=
# Optional, defaults to "Bookings"
GOOGLE_SHEET_TAB=Bookings

# =============================================================================
#  EMAIL  [RESEND REQUIRED for guest confirmations]
#  RESEND_API_KEY + NOTIFY_FROM are REQUIRED for guest confirmation emails.
#  Web3Forms and FormSubmit can only reach your own inbox, never a customer's.
# =============================================================================
RESEND_API_KEY=
NOTIFY_FROM=Nakshatraalay <bookings@astriseducation.in>
NOTIFY_EMAIL_1=astriseducation@gmail.com
NOTIFY_EMAIL_2=
WEB3FORMS_ACCESS_KEY=
